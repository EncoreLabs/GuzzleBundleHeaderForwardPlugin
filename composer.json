{
    "name": "encore-labs/guzzle-bundle-header-forward-plugin",
    "type": "library",
    "description": "Guzzle plugin that allow you to forward headers from your current request into the the guzzle one automatically. Forked to support Symfony 5.4, 6.4 and 7.x",
    "keywords": [
        "middleware",
        "plugin",
        "framework",
        "http",
        "rest",
        "web service",
        "curl",
        "client",
        "HTTP client",
        "guzzle",
        "header",
        "forward"
    ],
    "homepage": "https://github.com/EncoreLabs/GuzzleBundleHeaderForwardPlugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Adrien Roches",
            "email": "adrien@roc-it.tech",
            "homepage": "https://github.com/Neirda24"
        },
        {
            "name": "Tom Cawthorn"
        },
        {
            "name": "Community",
            "homepage": "https://github.com/Neirda24/GuzzleBundleHeaderForwardPlugin/contributors"
        }
    ],
    "require": {
        "guzzlehttp/guzzle": "^6.0 || ^7.0",
        "eightpoints/guzzle-bundle": "~8.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0",
        "symfony/config": "^5.4 || ^6.4 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0",
        "symfony/expression-language": "^5.4 || ^6.4 || ^7.0",
        "symfony/yaml": "^5.4 || ^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "EncoreLabs\\Bundle\\GuzzleBundleHeaderForwardPlugin\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EncoreLabs\\Bundle\\GuzzleBundleHeaderForwardPlugin\\Tests\\": "tests"
        }
    }
}
